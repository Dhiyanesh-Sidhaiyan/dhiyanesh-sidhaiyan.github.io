---
import '../styles/global.css';
import SocialIcon from '../components/SocialIcon.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Dhiyanesh Sidhaiyan, engineer and builder." } = Astro.props;
const navItems = [
  { href: '/experience', label: 'Experience' },
  { href: '/blog', label: 'Blog' },
  { href: '/research', label: 'Research' },
];
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Dhiyanesh Sidhaiyan</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand">Dhiyanesh Sidhaiyan</a>
        <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav">
          Menu
        </button>
        <nav class="site-nav" id="site-nav">
          {navItems.map((item) => (
            <a href={item.href} class={currentPath === item.href ? 'active' : ''}>{item.label}</a>
          ))}
          <span class="social-links nav-social">
            <a href="https://github.com/Dhiyanesh-Sidhaiyan" aria-label="GitHub" title="GitHub">
              <SocialIcon name="github" />
            </a>
            <a href="https://www.linkedin.com/in/dhiyanesh-s/" aria-label="LinkedIn" title="LinkedIn">
              <SocialIcon name="linkedin" />
            </a>
          </span>
        </nav>
      </div>
    </header>
    <div class="wrapper">
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Dhiyanesh Sidhaiyan</span>
        <span class="social-links">
          <a href="https://github.com/Dhiyanesh-Sidhaiyan" aria-label="GitHub" title="GitHub">
            <SocialIcon name="github" />
          </a>
          <a href="https://www.linkedin.com/in/dhiyanesh-s/" aria-label="LinkedIn" title="LinkedIn">
            <SocialIcon name="linkedin" />
          </a>
        </span>
      </footer>
    </div>
    <script>
      const toggle = document.getElementById('nav-toggle');
      const nav = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const open = nav?.getAttribute('data-open') === 'true';
        nav?.setAttribute('data-open', open ? 'false' : 'true');
        toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
      });
    </script>
  </body>
</html>
