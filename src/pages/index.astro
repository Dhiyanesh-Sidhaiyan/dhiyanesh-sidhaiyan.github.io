---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureIcon from '../components/FeatureIcon.astro';

const features = [
  {
    icon: 'code' as const,
    title: 'Frontend Engineering',
    text: 'Clean, responsive UI in React and Vue - I care as much about the product feel as the API underneath it.',
  },
  {
    icon: 'server' as const,
    title: 'Backend & Cloud',
    text: 'Microservices and APIs on AWS and GCP, built to hold up under real traffic - not just demo day.',
  },
  {
    icon: 'chip' as const,
    title: 'AI & LLM Systems',
    text: 'Agents, document intelligence, and automation that turn messy, unstructured input into decisions.',
  },
];

const skills = [
  'Python', 'Node.js', 'TypeScript', 'React', 'Vue.js', 'AWS', 'GCP',
  'Kubernetes', 'Docker', 'PostgreSQL', 'GraphQL', 'LangChain', 'LLMs', 'AI Agents',
];
---

<BaseLayout title="Home">
  <section class="hero">
    <p class="eyebrow">Full-Stack Software Engineer</p>
    <h1>Hi, I'm Dhiyanesh.</h1>
    <p class="lede">
      I love turning gnarly, ambiguous problems into clean, scalable systems - end to
      end, from the UI down to the infrastructure. Lately I'm teaching those systems to
      think: AI agents and automation are my newest obsession.
    </p>
    <div class="button-row">
      <a class="btn btn-primary" href="/projects">View Projects</a>
      <a class="btn btn-secondary" href="/blog">Read the Blog</a>
      <a class="btn btn-secondary" href="https://github.com/Dhiyanesh-Sidhaiyan">GitHub</a>
    </div>
  </section>

  <section class="feature-grid">
    {features.map((f) => (
      <div class="feature-card">
        <span class="feature-icon"><FeatureIcon name={f.icon} /></span>
        <h3>{f.title}</h3>
        <p class="muted">{f.text}</p>
      </div>
    ))}
  </section>

  <section class="skill-section">
    <h2>What I reach for</h2>
    <div class="tags skill-row">
      {skills.map((skill) => <span class="tag">{skill}</span>)}
    </div>
  </section>
</BaseLayout>
