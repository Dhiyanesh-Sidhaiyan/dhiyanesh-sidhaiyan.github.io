---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article>
    <h1>{project.data.title}</h1>
    <p class="meta">{project.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</p>
    <div class="tags">
      {project.data.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
    {project.data.link && <p><a href={project.data.link}>View project →</a></p>}
    <Content />
  </article>
</BaseLayout>
