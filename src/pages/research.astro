---
import BaseLayout from '../layouts/BaseLayout.astro';

const publications = [
  {
    title: 'GUS: A Graph Utility Score Framework for Method Selection in Fraud Detection',
    venue: 'Proc. 4th Intl. Conf. on Data Science, Agents and Artificial Intelligence (ICDSAAI 2026), IEEE',
    date: '2026',
    link: 'https://www.researchgate.net/publication/404748952_GUS_A_Graph_Utility_Score_Framework_for_Method_Selection_in_Fraud_Detection',
  },
  {
    title: 'Democratizing Pedagogical Content Creation: A Multi-Agent YouTube AI Framework for Empowering Indian Educators in Higher Education',
    venue: 'Intl. Conf. on Education and Learning with Artificial Intelligence (ICELAI-26)',
    date: '2026',
    link: 'https://harbinengineeringjournal.com/index.php/journal/article/view/5141',
  },
];

const recognitions = [
  {
    title: '19th of 150 in Google Hack2skill\'s "PromptWars"',
    venue: 'IIT Madras Research Park',
    date: 'May 2026',
  },
];
---

<BaseLayout title="Research">
  <h1>Research</h1>
  <p class="muted">Published papers and competition results. For articles and technical writing, see the Blog.</p>

  <h2>Publications</h2>
  <ul class="card-list">
    {publications.map((item) => (
      <li>
        <h3><a href={item.link} target="_blank" rel="noopener noreferrer">{item.title}</a></h3>
        <p class="meta">{item.venue} · {item.date}</p>
      </li>
    ))}
  </ul>

  <h2>Recognition</h2>
  <ul class="card-list">
    {recognitions.map((item) => (
      <li>
        <h3>{item.title}</h3>
        <p class="meta">{item.venue} · {item.date}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
