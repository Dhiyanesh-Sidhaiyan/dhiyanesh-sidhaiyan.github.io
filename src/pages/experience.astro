---
import BaseLayout from '../layouts/BaseLayout.astro';

const roles = [
  {
    domain: 'Product Company · Fintech & Risk Platforms',
    title: 'Senior Software Engineer',
    period: 'May 2024 - Present',
    location: 'Chennai, India · Hybrid',
    summary:
      'Own the architecture of cloud-native platforms that make credit and payment decisions, and lead a small team from design to production.',
    bullets: [
      'Lead a team of three engineers: set technical direction, review designs and code, and own delivery end to end.',
      'Replaced fragmented manual workflows with a service-based platform that has central risk tracking and real-time alerting.',
      'Built automated payment processing that is secure, validated and retry-safe by design, so failures surface immediately instead of days later.',
      'Designed explainable risk scoring and AI-agent systems that support daily credit decisions and that non-technical stakeholders can understand and trust.',
      'Introduced LLM-based document processing to cut manual review effort.',
    ],
    tags: ['Python', 'AWS', 'GCP', 'Kubernetes', 'LLMs', 'AI Agents'],
  },
  {
    domain: 'IT Services · Client Platforms',
    title: 'Senior Software Engineer',
    period: 'Dec 2018 - May 2024',
    location: 'Chennai, India · Hybrid',
    summary:
      'Delivered web platforms and conversational products across education, events, travel and finance.',
    bullets: [
      'Built a booking platform with pricing rules and automated email, deployed as infrastructure-as-code with 85%+ test coverage.',
      'Delivered a multilingual event platform for virtual and hybrid events, and cut page load time by 40% through API and loading optimisations.',
      'Led a two-engineer team on a real-time 3D experience prototype and modernised a legacy application.',
      'Built multi-channel chatbots and a speech-to-text application.',
    ],
    tags: ['Node.js', 'Python', 'AWS', 'MongoDB', 'GraphQL', 'Angular'],
  },
  {
    domain: 'IT Services',
    title: 'Associate Engineer',
    period: 'May 2017 - Feb 2018',
    location: 'Chennai, India',
    summary: 'Mapped business processes and used data analysis to find where they could be improved.',
    bullets: [],
    tags: ['SQL', 'Excel', 'Jira'],
  },
];

const education = {
  degree: 'B.E., Electrical & Electronics Engineering',
  school: 'Shree Venkateshwara Hi-Tech Engineering College, Tamil Nadu',
  period: '2013 - 2017',
};
---

<BaseLayout title="Experience">
  <h1>Experience</h1>
  <ul class="card-list">
    {roles.map((role) => (
      <li>
        <h3>{role.title}</h3>
        <p class="meta">{role.domain} · {role.period} · {role.location}</p>
        <p>{role.summary}</p>
        {role.bullets.length > 0 && (
          <ul>
            {role.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        )}
        <div class="tags">
          {role.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </li>
    ))}
  </ul>

  <h2>Education</h2>
  <ul class="card-list">
    <li>
      <h3>{education.degree}</h3>
      <p class="meta">{education.school} · {education.period}</p>
    </li>
  </ul>
</BaseLayout>
