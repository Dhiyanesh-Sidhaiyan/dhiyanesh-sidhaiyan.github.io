---
import BaseLayout from '../layouts/BaseLayout.astro';

const publications = [
  {
    title: 'GUS: A Graph Utility Score Framework for Method Selection in Fraud Detection',
    venue: 'Proc. 4th Intl. Conf. on Data Science, Agents and Artificial Intelligence (ICDSAAI 2026), IEEE',
    date: '2026',
  },
  {
    title: 'Democratizing Pedagogical Content Creation: A Multi-Agent YouTube AI Framework for Empowering Indian Educators in Higher Education',
    venue: 'Intl. Conf. on Education and Learning with Artificial Intelligence (ICELAI-26)',
    date: '2026',
  },
];

const recognitions = [
  {
    title: '19th of 150 — Google Hack2skill "PromptWars"',
    venue: 'IIT Madras Research Park',
    date: 'May 2026',
  },
];

const articles = [
  {
    title: 'The Biggest AI Mistake Companies Are Making — and Why You Should Use the Right Kind of Intelligence',
    link: 'https://www.linkedin.com/pulse/biggest-ai-mistake-companies-making-why-you-should-use-sidhaiyan-h4jcc/',
  },
  {
    title: 'Is GenAI Making Your Codebase a Ticking Time Bomb?',
    link: 'https://www.linkedin.com/pulse/genai-making-your-codebase-ticking-time-bomb-dhiyanesh-sidhaiyan-y5dgc/',
  },
  {
    title: 'The Day I Realized AI Agents Are Not the Future — But a Bridge',
    link: 'https://www.linkedin.com/pulse/day-i-realized-ai-agents-future-bridge-dhiyanesh-sidhaiyan-dfoec/',
  },
];
---

<BaseLayout title="Achievements">
  <h1>Achievements</h1>

  <h2>Publications</h2>
  <ul class="card-list">
    {publications.map((item) => (
      <li>
        <h3>{item.title}</h3>
        <p class="meta">{item.venue} · {item.date}</p>
      </li>
    ))}
  </ul>

  <h2>Recognition</h2>
  <ul class="card-list">
    {recognitions.map((item) => (
      <li>
        <h3>{item.title}</h3>
        <p class="meta">{item.venue} · {item.date}</p>
      </li>
    ))}
  </ul>

  <h2>Articles</h2>
  <ul class="card-list">
    {articles.map((item) => (
      <li>
        <h3><a href={item.link}>{item.title}</a></h3>
      </li>
    ))}
  </ul>
</BaseLayout>
