---
import BaseLayout from '../layouts/BaseLayout.astro';

const clients = [
  { name: 'IDP Education', outcome: 'Built and maintained chatbot and web services. Node.js, AWS, React, Terraform.' },
  { name: 'Michigan State University', outcome: 'Developed backend services and integrations. Node.js, MongoDB, AWS.' },
  { name: 'yellow.ai', outcome: 'Worked on conversational AI platforms, scalable microservices, and cloud deployments.' },
  { name: 'Clix Capital', outcome: 'Developed fintech applications. Python, Flask, Django REST, MySQL.' },
];
---

<BaseLayout title="Clients">
  <h1>Clients</h1>
  <p class="muted">Engagements from my time at HTC Global Services.</p>
  <ul class="card-list">
    {clients.map((client) => (
      <li>
        <h3>{client.name}</h3>
        <p>{client.outcome}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
